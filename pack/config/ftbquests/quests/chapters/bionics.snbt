		{
			title: "The Ox"
			icon: "createbionics:oxhauler_middle_item"
			x: 0.0d
			y: 4.5d
			description: [
				"The Oxhauler carries six chests and a 3x3 crafting grid. Place the Middle on the ground first. Then use the Rear, the Front, and the Head, in that order."
				"Give it a mechanical plough and it tills. Give it a mechanical harvester and it cuts crops. Empty it before you take it apart, and finish building before you load it."
				"Brass, while sneaking, repairs it."
			]
