	quests: [
		{
			title: "A Shoulder Lizard"
			icon: "createbionics:anole_item"
			x: 0.0d
			y: 0.0d
			description: [
				"The Anole is the first robot. Craft it from andesite alloy, copper, an iron sheet, and a transmitter."
				"Right-click the item on the ground to set it down. Feed it coal, charcoal, or a blaze cake. Hold the item and it sits on your shoulder. Spiders and insects keep away while it is with you."
				"Sneak and right-click with a copper ingot to repair it. A wrench clears skins. Sneak with the wrench to take it apart. Right-click with andesite, brass, copper, or netherite for a skin. A wet sponge weathers the copper look. A dry sponge takes that off."
			]
			tasks: [
				{
					type: "item"
					item: "createbionics:anole_item"
