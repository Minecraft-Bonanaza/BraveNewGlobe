		{
			title: "Ignition"
			icon: "creatingspace:small_rocket_engine"
			x: 2.0d
			y: 2.0d
			description: [
				"Assemble your first Small Rocket Engine. It won't reach orbit, but it proves the fuel-plus-oxidizer principle: an engine needs BOTH a propellant and oxygen to burn it."
				"Keep this in mind -- half your remaining work is producing those two fluids at scale."
			]
			tasks: [
