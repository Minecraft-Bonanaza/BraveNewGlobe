	quests: [
		{
			title: "First Steps to the Stars"
			icon: "creatingspace:rocket_engineer_table"
			x: 0.0d
			y: 0.0d
			description: [
				"Every launch begins at a workbench, not a launchpad. Craft the Rocket Engineering Table -- it's where blueprints, engines, and rocket parts come together."
				"This line is a standalone rocketry track. Strong Create power and some flight experience make the later stages far easier, but nothing here forces them -- you'll feel the need when you hit it."
			]
			tasks: [
