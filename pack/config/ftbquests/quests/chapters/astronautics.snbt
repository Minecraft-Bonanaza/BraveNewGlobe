		{
			title: "Combustion Basics"
			icon: "creatingspace:combustion_chamber"
			x: 2.0d
			y: 1.0d
			description: [
				"A rocket engine is a controlled explosion aimed downward. Build a Combustion Chamber (where fuel burns) and a Bell Nozzle (which turns that pressure into thrust)."
				"These two are the heart of every engine tier you'll make -- learn to mass them early."
			]
			tasks: [
